{
  "name": "@onenightcarnival/dsh-http",
  "version": "0.9.6",
  "description": "HTTP API client for DeepSeek Harness (dsh): API targets with host-side credentials, request builder, response viewer and shared history in the web GUI, with an optional http_* agent toolset.",
  "author": "onenightcarnival",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onenightcarnival/dsh-toolkit.git",
    "directory": "packages/http"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "http",
    "rest",
    "api",
    "postman"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-error": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  }
}
